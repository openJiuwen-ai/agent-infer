+    def get_mori_offload_tier_snapshot(self) -> SimpleCPUOffloadTierSnapshot:
+        """Return rank-local physical capacity without exposing pool internals."""
+        pending_store_ids = {
+            block_id
+            for transfer in (
+                *self._store_event_to_blocks.values(),
+                *self._pending_finished_stores,
+                *self._abandoned_store_event_to_blocks.values(),
+            )
+            for block_id in transfer.cpu_block_ids
+        }
+        pending_load_ids = {
+            block_id
+            for state in (
+                *self._reqs_to_load.values(),
+                *self._abandoned_reqs_to_load.values(),
+            )
+            for block_id in state.transfer_meta.cpu_block_ids
+        }
+        for (
+            cpu_hit_blocks,
+            _hit_length,
+            _num_computed_tokens,
+        ) in self._pending_cpu_hits.values():
+            pending_load_ids.update(
+                block.block_id
+                for group in cpu_hit_blocks
+                for block in group
+                if not block.is_null
+            )
+        return SimpleCPUOffloadTierSnapshot(
+            # Block 0 is the coordinator's permanent null block.
+            total_blocks=max(0, self.num_cpu_blocks - 1),
+            resident_blocks=len(self._mori_resident_block_ids),
+            pending_store_blocks=len(pending_store_ids),
+            pending_load_blocks=len(pending_load_ids),
+            scheduler_block_size=self.block_size,
+        )
