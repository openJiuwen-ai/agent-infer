+    def register_mori_offload_tier_provider(
+        self,
+        api_version: int,
+        provider: MoriSimpleCPUVictimProvider,
+    ) -> dict[str, int]:
+        """Install typed victim advice on this scheduler's CPU block pool."""
+        if api_version != 3 or provider.HOOK_API_VERSION != 3:
+            raise ValueError("unsupported MORI SimpleCPU offload-tier hook API")
+        if not self._mori_cpu_backend:
+            raise RuntimeError("MORI SimpleCPU support requires kv_offload_backend=cpu")
+        if self._lazy_mode:
+            raise RuntimeError("MORI SimpleCPU support requires lazy_offload=false")
+        if self._mori_offload_tier_provider not in (None, provider):
+            raise RuntimeError("a MORI SimpleCPU provider is already registered")
+        if self._mori_offload_tier_provider is provider:
+            return {"hook_api_version": 3}
+        register = getattr(
+            self.cpu_block_pool, "register_mori_block_selection_provider", None
+        )
+        if not callable(register):
+            raise RuntimeError(
+                "MORI SimpleCPU support requires the MORI BlockPool provider patch"
+            )
+        self._mori_resident_block_ids.clear()
+        bridge = _MoriSimpleCPUProviderBridge(
+            provider,
+            self._mori_resident_block_ids,
+        )
+        capabilities = register(bridge)
+        version = (
+            capabilities.get("hook_api_version")
+            if isinstance(capabilities, dict)
+            else None
+        )
+        if version != 1 or capabilities.get("store_admission_api_version") != 1:
+            unregister = getattr(
+                self.cpu_block_pool,
+                "unregister_mori_block_selection_provider",
+                None,
+            )
+            if callable(unregister):
+                unregister(bridge)
+            self._mori_resident_block_ids.clear()
+            raise RuntimeError(
+                f"unsupported MORI BlockPool hook API version: {version!r}"
+            )
+        self._mori_resident_block_ids.update(
+            block.block_id
+            for block in self.cpu_block_pool.blocks
+            if not block.is_null and block.block_hash is not None
+        )
+        self._mori_offload_tier_provider = provider
+        self._mori_offload_tier_bridge = bridge
+        self._mori_store_retries = {}
+        self._mori_pending_store_retries = {}
+        provider.bind_store_retry_listener(self._mori_retry_finished_store)
+        return {"hook_api_version": 3}
+
+    def unregister_mori_offload_tier_provider(
+        self, provider: MoriSimpleCPUVictimProvider
+    ) -> None:
+        if self._mori_offload_tier_provider is not provider:
+            return
+        provider.bind_store_retry_listener(None)
+        self._mori_store_retries.clear()
+        self._mori_pending_store_retries.clear()
+        unregister = getattr(
+            self.cpu_block_pool, "unregister_mori_block_selection_provider", None
+        )
+        bridge = self._mori_offload_tier_bridge
+        if callable(unregister) and bridge is not None:
+            unregister(bridge)
+        self._mori_offload_tier_provider = None
+        self._mori_offload_tier_bridge = None
+        self._mori_resident_block_ids.clear()
+
+    def _mori_store_capacity(self, request_id: object) -> int:
+        free = self.cpu_block_pool.get_num_free_blocks()
+        provider = self._mori_offload_tier_provider
+        if provider is None:
+            return free
+        return min(free, max(0, provider.store_capacity(request_id)))
+
+    def _allocate_store_blocks(
+        self, count: int, request_id: object
+    ) -> list["KVCacheBlock"]:
+        if self._mori_offload_tier_provider is None:
+            return self.cpu_block_pool.get_new_blocks(count)
+        try:
+            return self.cpu_block_pool.get_new_blocks(
+                count, mori_store_request_id=request_id
+            )
+        except ValueError:
+            # Optional backup: keep current CPU contents and retry positional
+            # blocks on a later step. Never fall back to unrestricted eviction.
+            return []
+
+    def _observe_mori_owner(
+        self, request_id: object, blocks: Iterable["KVCacheBlock"]
+    ) -> None:
+        observe = getattr(self.cpu_block_pool, "observe_mori_block_owner", None)
+        if callable(observe):
+            observe(request_id, blocks)
+
+    def _discard_mori_entries(self, block_ids: Iterable[int]) -> None:
+        provider = self._mori_offload_tier_provider
+        if provider is not None:
+            for block_id in block_ids:
+                self._mori_resident_block_ids.discard(block_id)
+                provider.on_block_removed(block_id)
+
+    def _mori_capture_finished_store(
+        self, request: "Request", block_ids: tuple[list[int], ...]
+    ) -> None:
+        """Remember immutable positional blocks, without retaining pins.
+
+        A later committed GPU-to-CPU transition may retry this context once.
+        Boundary-state handoffs and partial tails keep their existing semantics.
+        """
+        provider = self._mori_offload_tier_provider
+        gpu_pool = self._gpu_block_pool
+        if provider is None or gpu_pool is None:
+            return
+        context = provider.capture_store_retry_context(request.request_id)
+        if context is None:
+            return
+        self._mori_store_retries.pop(context, None)
+        confirmed = request.num_computed_tokens - request.num_output_placeholders
+        candidates: list[_MoriStoreRetryBlock] = []
+        seen: set[int] = set()
+        for group, ids in enumerate(block_ids):
+            if group not in self.prefix_cacheable_group_ids:
+                continue
+            manager = self.cpu_coordinator.single_type_managers[group]
+            if not manager.has_positionally_stable_blocks:
+                continue
+            size = self.group_block_sizes[group]
+            hashes = resolve_block_hashes(
+                request.block_hashes, self.hash_block_size, size
+            )
+            ready = min(len(ids), confirmed // size, len(hashes))
+            for position in range(ready):
+                block = gpu_pool.blocks[ids[position]]
+                expected = make_block_hash_with_group_id(hashes[position], group)
+                if (
+                    block.is_null
+                    or block.block_id in seen
+                    or block.block_hash != expected
+                    or block.block_hash_num_tokens != size
+                ):
+                    continue
+                seen.add(block.block_id)
+                candidates.append(_MoriStoreRetryBlock(block.block_id, expected, size))
+        if candidates:
+            self._mori_store_retries[context] = tuple(candidates)
+
+    def _mori_retry_finished_store(self, context: object, retry: bool) -> None:
+        """Queue an unpinned intent; do not mutate pools during MORI planning."""
+        candidates = self._mori_store_retries.pop(context, ())
+        if not retry:
+            self._mori_pending_store_retries.pop(context, None)
+        elif candidates:
+            self._mori_pending_store_retries[context] = candidates
+
+    def _mori_drain_store_retries(self) -> None:
+        pending = self._mori_pending_store_retries
+        self._mori_pending_store_retries = {}
+        for context, candidates in pending.items():
+            self._mori_submit_store_retry(context, candidates)
+
+    def _mori_submit_store_retry(
+        self, context: object, candidates: tuple[_MoriStoreRetryBlock, ...]
+    ) -> None:
+        """Submit once at the native boundary; rejected work holds no pins."""
+        provider = self._mori_offload_tier_provider
+        gpu_pool = self._gpu_block_pool
+        if (
+            not candidates
+            or provider is None
+            or gpu_pool is None
+            or not provider.store_retry_context_is_current(context)
+        ):
+            return
+        capacity = self._mori_store_capacity(context)
+        sources = []
+        for candidate in candidates:
+            if len(sources) >= capacity:
+                break
+            block = gpu_pool.blocks[candidate.block_id]
+            if (
+                block.is_null
+                or block.block_hash != candidate.block_hash
+                or block.block_hash_num_tokens != candidate.num_tokens
+                or self._classify_store_candidate(block, context)
+                is not _StoreAdmission.READY
+            ):
+                continue
+            sources.append(block)
+        if not sources:
+            return
+        destinations = self._allocate_store_blocks(len(sources), context)
+        if not destinations:
+            return
+        self._observe_mori_owner(context, destinations)
+        gpu_pool.touch(sources)
+        gpu_ids = [block.block_id for block in sources]
+        self._in_flight_store_gpu_blocks.update(gpu_ids)
+        self._pending_finished_stores.append(
+            TransferMeta(
+                gpu_ids,
+                [block.block_id for block in destinations],
+                [{} for _ in sources] if self.enable_kv_cache_events else None,
+            )
+        )
