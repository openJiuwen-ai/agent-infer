+    def _observe_mori_request_blocks(
+        self,
+        request_id: str,
+        newly_allocated: tuple[list[KVCacheBlock], ...],
+    ) -> None:
+        """Attach owners incrementally, scanning a request only once per residency."""
+        if self.block_pool._mori_block_selection_provider is None:
+            return
+        if request_id not in self._mori_observed_requests:
+            # Covers local hits and externally materialized prefix blocks on
+            # first admission or post-preemption resume. This is O(B_p) once,
+            # not once per decode step.
+            groups = self.coordinator.get_blocks(request_id)
+            blocks = (block for group in groups for block in group)
+            self._mori_observed_requests.add(request_id)
+        else:
+            blocks = (block for group in newly_allocated for block in group)
+        self.block_pool.observe_mori_block_owner(request_id, blocks)
 
