+    def register_mori_block_selection_provider(
+        self, provider: MoriBlockSelectionProvider
+    ) -> dict[str, int]:
+        if provider.HOOK_API_VERSION != 1:
+            raise ValueError("unsupported MORI block selection provider API")
+        if self._mori_block_selection_provider not in (None, provider):
+            raise RuntimeError("a MORI block selection provider is already registered")
+        free_blocks = self.free_block_queue.get_all_free_blocks()
+        self._mori_free_lru_seq = {
+            block.block_id: sequence for sequence, block in enumerate(free_blocks)
+        }
+        self._mori_next_front_seq = -1
+        self._mori_next_back_seq = len(free_blocks)
+        self._mori_block_selection_provider = provider
+        provider.on_cache_reset()
+        for block in free_blocks:
+            provider.on_block_ready(
+                block.block_id, self._mori_free_lru_seq[block.block_id]
+            )
+        return {"hook_api_version": 1, "store_admission_api_version": 1}
+
+    def unregister_mori_block_selection_provider(
+        self, provider: MoriBlockSelectionProvider
+    ) -> None:
+        if self._mori_block_selection_provider is provider:
+            self._mori_block_selection_provider = None
+            self._mori_free_lru_seq = None
+
+    def _mori_assign_front(self, blocks: Sequence[KVCacheBlock]) -> None:
+        if not blocks or self._mori_free_lru_seq is None:
+            return
+        start = self._mori_next_front_seq - len(blocks) + 1
+        for sequence, block in enumerate(blocks, start):
+            self._mori_free_lru_seq[block.block_id] = sequence
+        self._mori_next_front_seq = start - 1
+
+    def _mori_assign_back(self, blocks: Sequence[KVCacheBlock]) -> None:
+        if self._mori_free_lru_seq is None:
+            return
+        for block in blocks:
+            self._mori_free_lru_seq[block.block_id] = self._mori_next_back_seq
+            self._mori_next_back_seq += 1
