+/// Existing `session_params.session_id` is never overwritten. `agent_hint` is kept
+/// for upstream passthrough.
+///
+/// Parses JSON directly (no byte pre-filter) so escaped keys such as
+/// `\u0061gent_hint` still normalize correctly.
+pub fn inject_agent_hint_into_session_params(bytes: &[u8]) -> Option<Vec<u8>> {
+    let mut value: serde_json::Value = serde_json::from_slice(bytes).ok()?;
+    if !inject_agent_hint_into_session_params_value(&mut value) {
+        return None;
+    }
+
+    serde_json::to_vec(&value).ok()
+}
+
+fn error_indicates_payload_too_large(err: &(dyn StdError + 'static)) -> bool {
+    // axum::body::to_bytes wraps http_body_util::LengthLimitError, whose
+    // Display text is "length limit exceeded".
+    let mut current: Option<&(dyn StdError + 'static)> = Some(err);
+    while let Some(e) = current {
+        if e.to_string().contains("length limit exceeded") {
+            return true;
+        }
+        current = e.source();
+    }
+    false
+}
+
+/// Adapter: client `agent_hint.session_id` → router `session_params.session_id`.
+///
+/// `max_payload_size` bounds body buffering (aligned with the app payload limit).
+pub async fn agent_hint_affinity_middleware(
+    State(max_payload_size): State<usize>,
+    request: Request,
+    next: Next,
+) -> Response {
+    let (parts, body) = request.into_parts();
+    let bytes = match axum::body::to_bytes(body, max_payload_size).await {
+        Ok(bytes) => bytes,
+        Err(err) => {
+            if error_indicates_payload_too_large(&err) {
+                warn!(
+                    "agent_hint middleware rejected oversized body (limit {} bytes)",
+                    max_payload_size
+                );
+                return StatusCode::PAYLOAD_TOO_LARGE.into_response();
+            }
+            // Body already failed; let the handler see an empty body instead of
+            // collapsing every failure into a generic 400 here.
+            warn!(
+                "Failed to read request body for agent_hint middleware: {}",
+                err
+            );
+            let request = Request::from_parts(parts, axum::body::Body::empty());
+            return next.run(request).await;
+        }
+    };
+
+    let bytes = match inject_agent_hint_into_session_params(&bytes) {
+        Some(rewritten) => {
+            debug!("agent_hint middleware copied session_id into session_params");
+            rewritten.into()
+        }
+        None => bytes,
+    };
+
+    let request = Request::from_parts(parts, axum::body::Body::from(bytes));
+    next.run(request).await
+}
+
+fn log_agent_hint_token_offset_duration(started_at: &Instant, outcome: &str) {
+    let elapsed = started_at.elapsed();
+    debug!(
+        duration_us = elapsed.as_micros() as u64,
+        duration_ms = elapsed.as_secs_f64() * 1000.0,
+        outcome,
+        "agent_hint token offset middleware completed"
+    );
+}
+
+/// Adapter: session affinity plus message-offset → token/block coordinates.
+pub async fn agent_hint_token_offsets_middleware(
+    State(state): State<AgentHintTokenOffsetState>,
+    request: Request,
+    next: Next,
+) -> Response {
+    let started_at = Instant::now();
+    let (parts, body) = request.into_parts();
+    let bytes = match axum::body::to_bytes(body, state.max_payload_size).await {
+        Ok(bytes) => bytes,
+        Err(err) if error_indicates_payload_too_large(&err) => {
+            log_agent_hint_token_offset_duration(&started_at, "payload_too_large");
+            return StatusCode::PAYLOAD_TOO_LARGE.into_response();
+        }
+        Err(err) => {
+            error!("Failed to read request body for token offset middleware: {err}");
+            log_agent_hint_token_offset_duration(&started_at, "body_read_error");
+            return StatusCode::BAD_REQUEST.into_response();
+        }
+    };
+
+    let (bytes, outcome) = match rewrite_agent_hint_token_offsets(&bytes, &state) {
+        Ok(Some(rewritten)) => {
+            debug!("agent_hint token offset middleware rewrote request");
+            (rewritten.into(), "rewritten")
+        }
+        Ok(None) => (bytes, "unchanged"),
+        Err(TokenOffsetError::InvalidRequest(message)) => {
+            log_agent_hint_token_offset_duration(&started_at, "invalid_request");
+            return (
+                StatusCode::BAD_REQUEST,
+                axum::Json(serde_json::json!({
+                    "error": {
+                        "message": message,
+                        "type": "invalid_request_error"
+                    }
+                })),
+            )
+                .into_response();
+        }
+        Err(TokenOffsetError::Internal(message)) => {
+            error!("agent_hint token offset middleware failed: {message}");
+            log_agent_hint_token_offset_duration(&started_at, "internal_error");
+            return (
+                StatusCode::INTERNAL_SERVER_ERROR,
+                axum::Json(serde_json::json!({
+                    "error": {
+                        "message": "failed to calculate agent hint token offsets",
+                        "type": "server_error"
+                    }
+                })),
+            )
+                .into_response();
+        }
+    };
+
+    log_agent_hint_token_offset_duration(&started_at, outcome);
+    next.run(Request::from_parts(parts, axum::body::Body::from(bytes)))
+        .await
+}
