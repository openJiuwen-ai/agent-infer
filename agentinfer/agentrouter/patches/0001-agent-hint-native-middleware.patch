diff --git a/tests/test_agent_hint_routing.rs b/tests/test_agent_hint_routing.rs
new file mode 100644
index 0000000..eb3a617
--- /dev/null
+++ b/tests/test_agent_hint_routing.rs
@@ -0,0 +1,233 @@
+//! Agent-hint middleware → `session_params.session_id` → existing routing policies.
+
+use std::sync::Arc;
+
+use vllm_router_rs::core::{BasicWorker, DPAwareWorker, Worker, WorkerType};
+use vllm_router_rs::middleware::{
+    inject_agent_hint_into_session_params, session_id_from_agent_hint_body,
+};
+use vllm_router_rs::policies::{
+    CacheAwareConfig, CacheAwarePolicy, ConsistentHashPolicy, LoadBalancingPolicy,
+};
+use vllm_router_rs::protocols::spec::ChatCompletionRequest;
+
+fn create_test_workers() -> Vec<Arc<dyn Worker>> {
+    vec![
+        Arc::new(BasicWorker::new(
+            "http://worker1:8000".to_string(),
+            WorkerType::Regular,
+        )),
+        Arc::new(BasicWorker::new(
+            "http://worker2:8000".to_string(),
+            WorkerType::Regular,
+        )),
+        Arc::new(BasicWorker::new(
+            "http://worker3:8000".to_string(),
+            WorkerType::Regular,
+        )),
+    ]
+}
+
+fn create_dp_workers(base_url: &str, dp_size: usize) -> Vec<Arc<dyn Worker>> {
+    (0..dp_size)
+        .map(|rank| {
+            Arc::new(DPAwareWorker::new(
+                base_url.to_string(),
+                rank,
+                dp_size,
+                WorkerType::Regular,
+            )) as Arc<dyn Worker>
+        })
+        .collect()
+}
+
+fn agent_hint_body(session_id: &str, parent_session_id: &str) -> Vec<u8> {
+    serde_json::to_vec(&serde_json::json!({
+        "model": "test-model",
+        "messages": [{"role": "user", "content": format!("hello from {session_id}")}],
+        "agent_hint": {
+            "session_id": session_id,
+            "parent_session_id": parent_session_id,
+            "cache_control": {"type": "ephemeral"}
+        }
+    }))
+    .expect("serialize agent_hint body")
+}
+
+#[test]
+fn test_middleware_copies_own_session_id_not_parent() {
+    let body = agent_hint_body("child-a", "root-1");
+    assert_eq!(
+        session_id_from_agent_hint_body(&body).as_deref(),
+        Some("child-a")
+    );
+
+    let rewritten = inject_agent_hint_into_session_params(&body).expect("rewrite");
+    let req: ChatCompletionRequest = serde_json::from_slice(&rewritten).unwrap();
+    assert_eq!(
+        req.extract_session_id_for_routing().as_deref(),
+        Some("child-a")
+    );
+    assert_eq!(
+        req.agent_hint.as_ref().map(|h| h.session_id.as_str()),
+        Some("child-a")
+    );
+}
+
+#[test]
+fn test_same_session_id_selects_same_worker_across_turns() {
+    let policy = ConsistentHashPolicy::new();
+    let workers = create_test_workers();
+
+    let body = agent_hint_body("child-a", "root-1");
+    let rewritten = inject_agent_hint_into_session_params(&body).expect("rewrite");
+    let rewritten_str = std::str::from_utf8(&rewritten).unwrap();
+
+    let first = policy
+        .select_worker(&workers, Some(rewritten_str))
+        .expect("first turn");
+
+    for turn in 0..5 {
+        let turn_body = serde_json::to_vec(&serde_json::json!({
+            "messages": [{"role": "user", "content": format!("turn-{turn}")}],
+            "agent_hint": {
+                "session_id": "child-a",
+                "parent_session_id": "root-1"
+            }
+        }))
+        .unwrap();
+        let turn_rewritten =
+            inject_agent_hint_into_session_params(&turn_body).expect("rewrite turn");
+        let idx = policy
+            .select_worker(
+                &workers,
+                Some(std::str::from_utf8(&turn_rewritten).unwrap()),
+            )
+            .expect("turn select");
+        assert_eq!(idx, first, "turn {turn} drifted for same session_id");
+    }
+}
+
+#[test]
+fn test_cache_aware_agent_hint_sticks_to_dp_rank_across_turns() {
+    let policy = CacheAwarePolicy::with_config(CacheAwareConfig {
+        cache_threshold: 0.5,
+        balance_abs_threshold: 10_000,
+        balance_rel_threshold: 100.0,
+        eviction_interval_secs: 0,
+        max_tree_size: 10_000,
+    });
+    let workers = create_dp_workers("http://worker:8000", 4);
+    policy.init_workers(&workers);
+
+    let histories = [
+        serde_json::json!([{"role": "user", "content": "turn zero"}]),
+        serde_json::json!([{"role": "user", "content": "unrelated turn one"}]),
+        serde_json::json!([
+            {"role": "system", "content": "a new system prompt"},
+            {"role": "user", "content": "a third, different history"}
+        ]),
+    ];
+
+    let mut selected_rank = None;
+    for (turn, messages) in histories.into_iter().enumerate() {
+        let body = serde_json::to_vec(&serde_json::json!({
+            "model": "test-model",
+            "messages": messages,
+            "agent_hint": {
+                "session_id": "child-sticky",
+                "parent_session_id": "root-1"
+            }
+        }))
+        .unwrap();
+        let rewritten = inject_agent_hint_into_session_params(&body).expect("middleware rewrite");
+        let request: ChatCompletionRequest = serde_json::from_slice(&rewritten).unwrap();
+        let session_key = request
+            .extract_session_id_key_for_routing()
+            .expect("middleware-injected session routing key");
+        let full_history = request.extract_full_history_routing_text();
+
+        let selection = policy
+            .select_worker_with_fallback_headers_with_decision(
+                &workers,
+                Some(&session_key),
+                Some(&full_history),
+                None,
+            )
+            .expect("cache-aware DP selection");
+        let worker = &workers[selection.index];
+        let rank = worker.dp_rank().expect("DP-aware worker rank");
+
+        if let Some(expected_rank) = selected_rank {
+            assert_eq!(rank, expected_rank, "turn {turn} drifted to another rank");
+            assert_eq!(
+                selection.decision,
+                Some("session_id_match"),
+                "turn {turn} should use the warmed session key"
+            );
+        } else {
+            selected_rank = Some(rank);
+        }
+
+        assert!(worker.is_dp_aware());
+        assert_eq!(worker.dp_size(), Some(4));
+        assert_eq!(
+            worker.endpoint_url("/v1/chat/completions"),
+            "http://worker:8000/v1/chat/completions"
+        );
+    }
+}
+
+#[test]
+fn test_existing_session_params_not_overwritten() {
+    let body = serde_json::to_vec(&serde_json::json!({
+        "messages": [{"role": "user", "content": "hi"}],
+        "session_params": {"session_id": "already-set"},
+        "agent_hint": {
+            "session_id": "child-a",
+            "parent_session_id": "root-1"
+        }
+    }))
+    .unwrap();
+
+    assert!(inject_agent_hint_into_session_params(&body).is_none());
+    let req: ChatCompletionRequest = serde_json::from_slice(&body).unwrap();
+    assert_eq!(
+        req.extract_session_id_for_routing().as_deref(),
+        Some("already-set")
+    );
+}
+
+#[test]
+fn test_different_session_ids_can_select_different_workers() {
+    let policy = ConsistentHashPolicy::new();
+    let workers = create_test_workers();
+
+    let mut saw_different = false;
+    for i in 0..40 {
+        let a = inject_agent_hint_into_session_params(&agent_hint_body(
+            &format!("session-a-{i}"),
+            "root",
+        ))
+        .unwrap();
+        let b = inject_agent_hint_into_session_params(&agent_hint_body(
+            &format!("session-b-{i}"),
+            "root",
+        ))
+        .unwrap();
+        let idx_a = policy
+            .select_worker(&workers, Some(std::str::from_utf8(&a).unwrap()))
+            .unwrap();
+        let idx_b = policy
+            .select_worker(&workers, Some(std::str::from_utf8(&b).unwrap()))
+            .unwrap();
+        if idx_a != idx_b {
+            saw_different = true;
+            break;
+        }
+    }
+    assert!(
+        saw_different,
+        "different session_ids should be able to land on different workers"
+    );
+}
