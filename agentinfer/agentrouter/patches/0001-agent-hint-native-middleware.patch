+#[test]
+fn test_agentic_context_survives_agent_hint_middleware_and_typed_roundtrip() {
+    let agentic_context = r#"{"program_id":"child-1","task_id":"root-1","agent_id":"child-1"}"#;
+    let body = serde_json::to_vec(&serde_json::json!({
+        "model": "test-model",
+        "messages": [{"role": "user", "content": "Hello"}],
+        "agent_hint": {
+            "session_id": "child-1",
+            "parent_session_id": "root-1"
+        },
+        "vllm_xargs": {
+            "agentic_context": agentic_context
+        }
+    }))
+    .unwrap();
+
+    let rewritten = inject_agent_hint_into_session_params(&body).expect("middleware rewrite");
+    let request: ChatCompletionRequest = serde_json::from_slice(&rewritten).unwrap();
+    let forwarded = serde_json::to_value(&request).unwrap();
+
+    assert_eq!(forwarded["session_params"]["session_id"], "child-1");
+    assert_eq!(forwarded["vllm_xargs"]["agentic_context"], agentic_context);
+    assert_eq!(forwarded["agent_hint"]["session_id"], "child-1");
+    assert_eq!(forwarded["agent_hint"]["parent_session_id"], "root-1");
+}
+
+#[test]
+fn test_agent_hint_cache_offsets_survive_typed_roundtrip() {
+    let request: ChatCompletionRequest = serde_json::from_value(serde_json::json!({
+        "model": "test-model",
+        "messages": [{"role": "user", "content": "Hello"}],
+        "agent_hint": {
+            "session_id": "session-1",
+            "cache_control": {
+                "type": "ephemeral",
+                "ttl": 300,
+                "msg_offset": 1,
+                "token_offset": 130,
+                "block_offset": 1,
+                "intra_block_offset": 2,
+                "extension": true
+            },
+            "agent_extension": "preserved"
+        }
+    }))
+    .unwrap();
+
+    let forwarded = serde_json::to_value(request).unwrap();
+    assert_eq!(
+        forwarded["agent_hint"]["cache_control"]["token_offset"],
+        130
+    );
+    assert_eq!(forwarded["agent_hint"]["cache_control"]["block_offset"], 1);
+    assert_eq!(
+        forwarded["agent_hint"]["cache_control"]["intra_block_offset"],
+        2
+    );
+    assert_eq!(forwarded["agent_hint"]["cache_control"]["extension"], true);
+    assert_eq!(forwarded["agent_hint"]["agent_extension"], "preserved");
+}
