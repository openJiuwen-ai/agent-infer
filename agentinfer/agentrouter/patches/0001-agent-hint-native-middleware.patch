+#[derive(Clone, Default)]
+pub struct ChatMiddlewareConfig {
+    pub middlewares: Vec<middleware::RouterMiddleware>,
+    pub token_offset_state: Option<crate::agent_hint_token_offsets::AgentHintTokenOffsetState>,
+}
+
+fn apply_chat_middlewares<S>(
+    mut routes: Router<S>,
+    max_payload_size: usize,
+    config: &ChatMiddlewareConfig,
+) -> Router<S>
+where
+    S: Clone + Send + Sync + 'static,
+{
+    if config
+        .middlewares
+        .contains(&middleware::RouterMiddleware::AgentHintTokenOffsets)
+    {
+        let state = config
+            .token_offset_state
+            .clone()
+            .expect("agent_hint_token_offsets middleware requires initialized tokenizer state");
+        routes = routes.route_layer(axum::middleware::from_fn_with_state(
+            state,
+            middleware::agent_hint_token_offsets_middleware,
+        ));
+    } else if config
+        .middlewares
+        .contains(&middleware::RouterMiddleware::AgentHintAffinity)
+    {
+        routes = routes.route_layer(axum::middleware::from_fn_with_state(
+            max_payload_size,
+            middleware::agent_hint_affinity_middleware,
+        ));
+    }
+    routes
+}
