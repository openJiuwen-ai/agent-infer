+pub fn validate_agent_hint_middleware_config(
+    middlewares: &[RouterMiddleware],
+    tokenizer_path: Option<&str>,
+    block_size: Option<usize>,
+) -> Result<(), String> {
+    let affinity_enabled = middlewares.contains(&RouterMiddleware::AgentHintAffinity);
+    let offsets_enabled = middlewares.contains(&RouterMiddleware::AgentHintTokenOffsets);
+    if affinity_enabled && offsets_enabled {
+        return Err(format!(
+            "{} and {} are mutually exclusive",
+            RouterMiddleware::AgentHintAffinity,
+            RouterMiddleware::AgentHintTokenOffsets
+        ));
+    }
+    if offsets_enabled {
+        if tokenizer_path
+            .map(str::trim)
+            .filter(|v| !v.is_empty())
+            .is_none()
+        {
+            return Err(format!(
+                "--agent-hint-tokenizer is required with --middleware {}",
+                RouterMiddleware::AgentHintTokenOffsets
+            ));
+        }
+        if block_size == Some(0) || block_size.is_none() {
+            return Err(format!(
+                "--agent-hint-block-size must be greater than zero with --middleware {}",
+                RouterMiddleware::AgentHintTokenOffsets
+            ));
+        }
+    }
+    Ok(())
+}
