+pub fn session_id_from_agent_hint_body(bytes: &[u8]) -> Option<String> {
+    let value: serde_json::Value = serde_json::from_slice(bytes).ok()?;
+    session_id_from_agent_hint_value(&value)
+}
+
+fn session_id_from_agent_hint_value(value: &serde_json::Value) -> Option<String> {
+    value
+        .get("agent_hint")?
+        .get("session_id")?
+        .as_str()
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .map(|s| s.to_string())
+}
+
+fn body_has_session_params_session_id(value: &serde_json::Value) -> bool {
+    value
+        .get("session_params")
+        .and_then(|sp| sp.get("session_id"))
+        .and_then(|v| v.as_str())
+        .map(|s| !s.trim().is_empty())
+        .unwrap_or(false)
+}
+
+pub(crate) fn inject_agent_hint_into_session_params_value(value: &mut serde_json::Value) -> bool {
+    if body_has_session_params_session_id(value) {
+        return false;
+    }
+
+    let Some(session_id) = session_id_from_agent_hint_value(value) else {
+        return false;
+    };
+    let Some(obj) = value.as_object_mut() else {
+        return false;
+    };
+    let session_params = obj
+        .entry("session_params")
+        .or_insert_with(|| serde_json::json!({}));
+    let Some(session_params) = session_params.as_object_mut() else {
+        return false;
+    };
+    session_params.insert(
+        "session_id".to_string(),
+        serde_json::Value::String(session_id),
+    );
+    true
