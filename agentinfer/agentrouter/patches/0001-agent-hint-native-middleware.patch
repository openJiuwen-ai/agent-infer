+        template_kwargs: Option<&serde_json::Map<String, serde_json::Value>>,
+    ) -> Result<String> {
+        let template = self
+            .chat_template
+            .as_ref()
+            .ok_or_else(|| Error::msg("No chat template configured for tokenizer"))?;
+        let processor = ChatTemplateProcessor::new(
+            template.clone(),
+            self.special_tokens.bos_token.clone(),
+            self.special_tokens.eos_token.clone(),
+        );
+        processor.apply_chat_template_values_with_kwargs(
+            messages,
+            tools,
+            add_generation_prompt,
+            template_kwargs,
+        )
+    }
 }
 
