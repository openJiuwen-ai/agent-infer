diff --git a/src/agent_hint_token_offsets.rs b/src/agent_hint_token_offsets.rs
new file mode 100644
index 0000000..798bae6
--- /dev/null
+++ b/src/agent_hint_token_offsets.rs
@@ -0,0 +1,510 @@
+use std::sync::Arc;
+
+use serde_json::Value;
+use thiserror::Error;
+
+use crate::middleware::inject_agent_hint_into_session_params_value;
+use crate::tokenizer::huggingface::HuggingFaceTokenizer;
+use crate::tokenizer::traits::{Encoder, Tokenizer as TokenizerTrait};
+
+const DERIVED_CACHE_FIELDS: [&str; 3] = ["token_offset", "block_offset", "intra_block_offset"];
+const CHAT_MESSAGE_MARKERS: [&str; 4] = [
+    "<|im_start|>",
+    "<|start_header_id|>",
+    "<start_of_turn>",
+    "[INST]",
+];
+
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum TokenOffsetError {
+    #[error("{0}")]
+    InvalidRequest(String),
+    #[error("{0}")]
+    Internal(String),
+}
+
+pub trait MessageOffsetCalculator: Send + Sync {
+    fn message_token_offsets(
+        &self,
+        messages: &[Value],
+        tools: Option<&[Value]>,
+        template_kwargs: Option<&serde_json::Map<String, Value>>,
+        add_generation_prompt: bool,
+    ) -> Result<Vec<usize>, String>;
+}
+
+struct HuggingFaceMessageOffsetCalculator {
+    tokenizer: HuggingFaceTokenizer,
+}
+
+impl HuggingFaceMessageOffsetCalculator {
+    fn from_files(tokenizer_path: &str, chat_template_path: Option<&str>) -> Result<Self, String> {
+        let tokenizer =
+            HuggingFaceTokenizer::from_file_with_chat_template(tokenizer_path, chat_template_path)
+                .map_err(|err| err.to_string())?;
+        if !tokenizer.has_chat_template() {
+            return Err("no chat template found; provide --agent-hint-chat-template".to_string());
+        }
+        Ok(Self { tokenizer })
+    }
+
+    fn encode(&self, rendered: &str) -> Result<Vec<u32>, String> {
+        self.tokenizer
+            .encode(rendered)
+            .map(|encoding| encoding.token_ids().to_vec())
+            .map_err(|err| err.to_string())
+    }
+}
+
+impl MessageOffsetCalculator for HuggingFaceMessageOffsetCalculator {
+    fn message_token_offsets(
+        &self,
+        messages: &[Value],
+        tools: Option<&[Value]>,
+        template_kwargs: Option<&serde_json::Map<String, Value>>,
+        add_generation_prompt: bool,
+    ) -> Result<Vec<usize>, String> {
+        let rendered = self
+            .tokenizer
+            .apply_chat_template_values_with_kwargs(
+                messages,
+                tools,
+                add_generation_prompt,
+                template_kwargs,
+            )
+            .map_err(|err| err.to_string())?;
+        let token_ids = self.encode(&rendered)?;
+
+        for marker in CHAT_MESSAGE_MARKERS {
+            let Some(marker_id) = self.tokenizer.token_to_id(marker) else {
+                continue;
+            };
+            let offsets: Vec<usize> = token_ids
+                .iter()
+                .enumerate()
+                .filter_map(|(index, token_id)| (*token_id == marker_id).then_some(index))
+                .collect();
+            if offsets.len() == messages.len()
+                || (add_generation_prompt && offsets.len() == messages.len() + 1)
+            {
+                return Ok(offsets.into_iter().take(messages.len()).collect());
+            }
+        }
+
+        // Generic append-only fallback. It is intentionally strict: every
+        // rendered prefix must be an exact token prefix of the complete chat.
+        let mut offsets = Vec::with_capacity(messages.len());
+        for index in 0..messages.len() {
+            let prefix = self
+                .tokenizer
+                .apply_chat_template_values_with_kwargs(
+                    &messages[..index],
+                    tools,
+                    false,
+                    template_kwargs,
+                )
+                .map_err(|err| err.to_string())?;
+            let prefix_ids = self.encode(&prefix)?;
+            if !token_ids.starts_with(&prefix_ids) {
+                return Err(format!(
+                    "chat template is not append-only at message index {index}"
+                ));
+            }
+            offsets.push(prefix_ids.len());
+        }
+        Ok(offsets)
+    }
+}
+
+#[derive(Clone)]
+pub struct AgentHintTokenOffsetState {
+    pub max_payload_size: usize,
+    pub block_size: usize,
+    calculator: Arc<dyn MessageOffsetCalculator>,
+}
+
+impl AgentHintTokenOffsetState {
+    pub fn from_files(
+        max_payload_size: usize,
+        block_size: usize,
+        tokenizer_path: &str,
+        chat_template_path: Option<&str>,
+    ) -> Result<Self, String> {
+        if block_size == 0 {
+            return Err("agent hint block size must be greater than zero".to_string());
+        }
+        let calculator =
+            HuggingFaceMessageOffsetCalculator::from_files(tokenizer_path, chat_template_path)?;
+        Ok(Self {
+            max_payload_size,
+            block_size,
+            calculator: Arc::new(calculator),
+        })
+    }
+
+    #[cfg(test)]
+    pub(crate) fn for_test(
+        max_payload_size: usize,
+        block_size: usize,
+        calculator: Arc<dyn MessageOffsetCalculator>,
+    ) -> Self {
+        Self {
+            max_payload_size,
+            block_size,
+            calculator,
+        }
+    }
+}
+
+fn non_empty_session_id(agent_hint: &Value) -> bool {
+    agent_hint
+        .get("session_id")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .is_some_and(|session_id| !session_id.is_empty())
+}
+
+fn parse_msg_offset(
+    cache_control: &serde_json::Map<String, Value>,
+    count: usize,
+) -> Result<usize, TokenOffsetError> {
+    let offset = match cache_control.get("msg_offset") {
+        None | Some(Value::Null) => count,
+        Some(Value::Number(number)) => number
+            .as_u64()
+            .and_then(|value| usize::try_from(value).ok())
+            .ok_or_else(|| {
+                TokenOffsetError::InvalidRequest(
+                    "agent_hint.cache_control.msg_offset must be a positive integer".to_string(),
+                )
+            })?,
+        Some(_) => {
+            return Err(TokenOffsetError::InvalidRequest(
+                "agent_hint.cache_control.msg_offset must be a positive integer".to_string(),
+            ))
+        }
+    };
+    if offset == 0 || offset > count {
+        return Err(TokenOffsetError::InvalidRequest(format!(
+            "agent_hint.cache_control.msg_offset must be in [1, {count}]"
+        )));
+    }
+    Ok(offset)
+}
+
+pub fn rewrite_agent_hint_token_offsets(
+    bytes: &[u8],
+    state: &AgentHintTokenOffsetState,
+) -> Result<Option<Vec<u8>>, TokenOffsetError> {
+    let mut value: Value = serde_json::from_slice(bytes).map_err(|err| {
+        TokenOffsetError::InvalidRequest(format!("invalid JSON request body: {err}"))
+    })?;
+    if !value.is_object() {
+        return Err(TokenOffsetError::InvalidRequest(
+            "request body must be a JSON object".to_string(),
+        ));
+    }
+
+    let session_injected = inject_agent_hint_into_session_params_value(&mut value);
+    let Some(agent_hint_value) = value.get("agent_hint") else {
+        return if session_injected {
+            serde_json::to_vec(&value)
+                .map(Some)
+                .map_err(|err| TokenOffsetError::Internal(err.to_string()))
+        } else {
+            Ok(None)
+        };
+    };
+    if !agent_hint_value.is_object() {
+        return Err(TokenOffsetError::InvalidRequest(
+            "agent_hint must be a JSON object".to_string(),
+        ));
+    }
+    if agent_hint_value.get("cache_control").is_none() {
+        return if session_injected {
+            serde_json::to_vec(&value)
+                .map(Some)
+                .map_err(|err| TokenOffsetError::Internal(err.to_string()))
+        } else {
+            Ok(None)
+        };
+    }
+    if !non_empty_session_id(agent_hint_value) {
+        return Err(TokenOffsetError::InvalidRequest(
+            "agent_hint.session_id is required for cache offset translation".to_string(),
+        ));
+    }
+
+    let messages = value
+        .get("messages")
+        .and_then(Value::as_array)
+        .filter(|messages| !messages.is_empty())
+        .cloned()
+        .ok_or_else(|| {
+            TokenOffsetError::InvalidRequest(
+                "a non-empty messages array is required for cache offset translation".to_string(),
+            )
+        })?;
+    let tools = match value.get("tools") {
+        None | Some(Value::Null) => None,
+        Some(Value::Array(tools)) => Some(tools.clone()),
+        Some(_) => {
+            return Err(TokenOffsetError::InvalidRequest(
+                "tools must be an array when provided".to_string(),
+            ))
+        }
+    };
+    let template_kwargs = match value.get("chat_template_kwargs") {
+        None | Some(Value::Null) => None,
+        Some(Value::Object(kwargs)) => Some(kwargs.clone()),
+        Some(_) => {
+            return Err(TokenOffsetError::InvalidRequest(
+                "chat_template_kwargs must be a JSON object when provided".to_string(),
+            ))
+        }
+    };
+    let add_generation_prompt = match value.get("add_generation_prompt") {
+        None | Some(Value::Null) => true,
+        Some(Value::Bool(value)) => *value,
+        Some(_) => {
+            return Err(TokenOffsetError::InvalidRequest(
+                "add_generation_prompt must be a boolean when provided".to_string(),
+            ))
+        }
+    };
+    let msg_offset = {
+        let cache_control = agent_hint_value
+            .get("cache_control")
+            .and_then(Value::as_object)
+            .ok_or_else(|| {
+                TokenOffsetError::InvalidRequest(
+                    "agent_hint.cache_control must be a JSON object".to_string(),
+                )
+            })?;
+        match cache_control.get("type") {
+            None | Some(Value::Null) => {}
+            Some(Value::String(value)) if value.is_empty() || value == "ephemeral" => {}
+            _ => {
+                return Err(TokenOffsetError::InvalidRequest(
+                    "agent_hint.cache_control.type must be 'ephemeral'".to_string(),
+                ))
+            }
+        }
+        parse_msg_offset(cache_control, messages.len())?
+    };
+
+    let offsets = state
+        .calculator
+        .message_token_offsets(
+            &messages,
+            tools.as_deref(),
+            template_kwargs.as_ref(),
+            add_generation_prompt,
+        )
+        .map_err(|err| {
+            TokenOffsetError::Internal(format!("failed to calculate message token offsets: {err}"))
+        })?;
+    if offsets.len() != messages.len() {
+        return Err(TokenOffsetError::Internal(format!(
+            "tokenizer produced {} message offsets for {} messages",
+            offsets.len(),
+            messages.len()
+        )));
+    }
+
+    let agent_hint = value
+        .get_mut("agent_hint")
+        .and_then(Value::as_object_mut)
+        .expect("agent_hint shape checked above");
+    let cache_control = agent_hint
+        .get_mut("cache_control")
+        .and_then(Value::as_object_mut)
+        .ok_or_else(|| {
+            TokenOffsetError::InvalidRequest(
+                "agent_hint.cache_control must be a JSON object".to_string(),
+            )
+        })?;
+
+    if !matches!(
+        cache_control.get("type"),
+        Some(Value::String(value)) if value == "ephemeral"
+    ) {
+        cache_control.insert("type".to_string(), Value::String("ephemeral".to_string()));
+    }
+
+    for field in DERIVED_CACHE_FIELDS {
+        cache_control.remove(field);
+    }
+    cache_control.insert("msg_offset".to_string(), Value::from(msg_offset));
+    let token_offset = offsets[msg_offset - 1];
+    cache_control.insert("token_offset".to_string(), Value::from(token_offset));
+    cache_control.insert(
+        "block_offset".to_string(),
+        Value::from(token_offset / state.block_size),
+    );
+    cache_control.insert(
+        "intra_block_offset".to_string(),
+        Value::from(token_offset % state.block_size),
+    );
+
+    serde_json::to_vec(&value)
+        .map(Some)
+        .map_err(|err| TokenOffsetError::Internal(err.to_string()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use tempfile::TempDir;
+
+    struct FixedOffsets(Vec<usize>);
+
+    impl MessageOffsetCalculator for FixedOffsets {
+        fn message_token_offsets(
+            &self,
+            _messages: &[Value],
+            _tools: Option<&[Value]>,
+            _template_kwargs: Option<&serde_json::Map<String, Value>>,
+            _add_generation_prompt: bool,
+        ) -> Result<Vec<usize>, String> {
+            Ok(self.0.clone())
+        }
+    }
+
+    fn state(offsets: Vec<usize>) -> AgentHintTokenOffsetState {
+        AgentHintTokenOffsetState::for_test(1024 * 1024, 128, Arc::new(FixedOffsets(offsets)))
+    }
+
+    #[test]
+    fn rewrites_session_and_cache_offsets() {
+        let body = serde_json::to_vec(&serde_json::json!({
+            "messages": [
+                {"role": "user", "content": "first"},
+                {"role": "assistant", "content": "second"}
+            ],
+            "agent_hint": {
+                "session_id": "session-1",
+                "cache_control": {
+                    "type": "ephemeral",
+                    "msg_offset": 2,
+                    "token_offset": 999,
+                    "extension": true
+                }
+            },
+            "vllm_xargs": {"agentic_context": "{\"program_id\":\"session-1\"}"}
+        }))
+        .unwrap();
+
+        let rewritten = rewrite_agent_hint_token_offsets(&body, &state(vec![5, 130]))
+            .unwrap()
+            .unwrap();
+        let value: Value = serde_json::from_slice(&rewritten).unwrap();
+        assert_eq!(value["session_params"]["session_id"], "session-1");
+        assert_eq!(value["agent_hint"]["cache_control"]["token_offset"], 130);
+        assert_eq!(value["agent_hint"]["cache_control"]["block_offset"], 1);
+        assert_eq!(
+            value["agent_hint"]["cache_control"]["intra_block_offset"],
+            2
+        );
+        assert_eq!(value["agent_hint"]["cache_control"]["extension"], true);
+        assert_eq!(
+            value["vllm_xargs"]["agentic_context"],
+            "{\"program_id\":\"session-1\"}"
+        );
+    }
+
+    #[test]
+    fn defaults_msg_offset_to_last_message() {
+        let body = br#"{
+            "messages":[{"role":"user","content":"first"},{"role":"assistant","content":"second"}],
+            "agent_hint":{"session_id":"session-1","cache_control":{}}
+        }"#;
+        let rewritten = rewrite_agent_hint_token_offsets(body, &state(vec![7, 257]))
+            .unwrap()
+            .unwrap();
+        let value: Value = serde_json::from_slice(&rewritten).unwrap();
+        assert_eq!(value["agent_hint"]["cache_control"]["msg_offset"], 2);
+        assert_eq!(value["agent_hint"]["cache_control"]["token_offset"], 257);
+        assert_eq!(value["agent_hint"]["cache_control"]["block_offset"], 2);
+        assert_eq!(
+            value["agent_hint"]["cache_control"]["intra_block_offset"],
+            1
+        );
+    }
+
+    #[test]
+    fn rejects_out_of_range_msg_offset() {
+        let body = br#"{
+            "messages":[{"role":"user","content":"first"}],
+            "agent_hint":{"session_id":"session-1","cache_control":{"msg_offset":2}}
+        }"#;
+        assert_eq!(
+            rewrite_agent_hint_token_offsets(body, &state(vec![0])),
+            Err(TokenOffsetError::InvalidRequest(
+                "agent_hint.cache_control.msg_offset must be in [1, 1]".to_string()
+            ))
+        );
+    }
+
+    #[test]
+    fn session_only_hint_retains_affinity_behavior() {
+        let body = br#"{
+            "messages":[{"role":"user","content":"first"}],
+            "agent_hint":{"session_id":"session-1"}
+        }"#;
+        let rewritten = rewrite_agent_hint_token_offsets(body, &state(vec![0]))
+            .unwrap()
+            .unwrap();
+        let value: Value = serde_json::from_slice(&rewritten).unwrap();
+        assert_eq!(value["session_params"]["session_id"], "session-1");
+        assert!(value["agent_hint"].get("cache_control").is_none());
+    }
+
+    #[test]
+    fn huggingface_calculator_uses_configured_chat_template() {
+        let temp_dir = TempDir::new().unwrap();
+        let tokenizer_path = temp_dir.path().join("tokenizer.json");
+        fs::write(
+            &tokenizer_path,
+            r#"{
+                "version":"1.0",
+                "truncation":null,
+                "padding":null,
+                "added_tokens":[],
+                "normalizer":null,
+                "pre_tokenizer":{"type":"Whitespace"},
+                "post_processor":null,
+                "decoder":null,
+                "model":{
+                    "type":"WordLevel",
+                    "vocab":{"first":0,"second":1,"[UNK]":2},
+                    "unk_token":"[UNK]"
+                }
+            }"#,
+        )
+        .unwrap();
+        let template_path = temp_dir.path().join("chat_template.jinja");
+        fs::write(
+            &template_path,
+            "{% for message in messages %}{{ message.content }} {% endfor %}",
+        )
+        .unwrap();
+
+        let calculator = HuggingFaceMessageOffsetCalculator::from_files(
+            tokenizer_path.to_str().unwrap(),
+            Some(template_path.to_str().unwrap()),
+        )
+        .unwrap();
+        let messages = vec![
+            serde_json::json!({"role":"user","content":"first"}),
+            serde_json::json!({"role":"assistant","content":"second"}),
+        ];
+        assert_eq!(
+            calculator
+                .message_token_offsets(&messages, None, None, false)
+                .unwrap(),
+            vec![0, 1]
+        );
+    }
+}
