# Disabled scaffold: adapt to the engine's real language and commands first.
# Replace all <...> placeholders, then review and rename to ci-draft.yml.
# Use real checks; no model downloads, hardware benchmarks or campaign gates.
name: Engine lightweight checks

on:
  pull_request:
  push:
    branches-ignore:
      - main

permissions:
  contents: read

jobs:
  lint-and-smoke:
    runs-on: "<cpu-runner-label>"
    steps:
      - uses: actions/checkout@v4
      # Add the actual pinned language/toolchain setup action when required.
      - name: Install dependencies
        run: |
          <install-development-dependencies-command>
      - name: Lint or build
        run: |
          <lint-or-build-command>
      - name: CPU correctness checks
        run: |
          <lightweight-test-command>
