{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-evolve/schemas/eval_result.schema.json",
  "title": "eval_result",
  "description": "One policy evaluation on one benchmark profile. Written to archive_policies/<run_id>/eval_result.json and validated on insert.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "policy_sha256",
    "config_sha256",
    "git_sha",
    "vllm_version",
    "hardware_profile",
    "profile",
    "regime",
    "primary_metric",
    "seeds",
    "sample_count",
    "raw_per_seed_metrics",
    "aggregate_metrics",
    "slo",
    "outcome_class",
    "score_aggregation_formula_version",
    "command_line",
    "wall_time_s"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "source": {
      "type": "string",
      "enum": ["real_vllm", "local_smoke", "frontier_sim"],
      "description": "real_vllm = a real-vLLM run (the only kind that can ever be a gain/keep/AC6). local_smoke = a synthetic in-process plumbing run; never a real result. frontier_sim = an out-of-process Frontier discrete-event-simulator run that may execute schedule_batch through ve_policy; useful for search but non-real and never a gain/keep/AC6."
    },
    "policy_sha256": { "type": "string" },
    "config_sha256": { "type": "string" },
    "git_sha": { "type": "string" },
    "vllm_version": { "type": "string" },
    "vllm_commit": { "type": ["string", "null"] },
    "cuda_version": { "type": ["string", "null"] },
    "gpu_driver_version": { "type": ["string", "null"] },
    "hardware_profile": { "type": "string" },
    "hardware_sku": { "type": ["string", "null"] },
    "docker_image_digest": { "type": ["string", "null"] },
    "profile": { "type": "string" },
    "regime": { "type": "string", "enum": ["throughput", "latency", "replay"] },
    "primary_metric": { "type": "string" },
    "seeds": { "type": "array", "items": { "type": "integer" } },
    "sample_count": { "type": "integer", "minimum": 1 },
    "raw_per_seed_metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" },
      "description": "One entry per seed run; aggregates must be recomputable from these."
    },
    "aggregate_metrics": { "type": "object" },
    "slo": { "type": "object" },
    "goodput": { "type": ["object", "null"] },
    "outcome_class": {
      "type": "string",
      "enum": [
        "safety_rejection",
        "plugin_load_failure",
        "plugin_ineffective",
        "vllm_crash",
        "bench_timeout",
        "invalid_metrics",
        "l3_overfit_rejection",
        "hardware_unavailable",
        "high_variance_inconclusive",
        "eval_result",
        "unclassified_failure",
        "local_smoke_nonqualifying",
        "simulator_nonqualifying"
      ]
    },
    "score_aggregation_formula_version": { "type": "string" },
    "warmup_policy_version": { "type": ["string", "null"] },
    "command_line": { "type": "string" },
    "wall_time_s": { "type": "number", "minimum": 0 },
    "error_text": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
