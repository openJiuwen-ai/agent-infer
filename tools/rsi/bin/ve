#!/usr/bin/env bash
# Dev shim: invoke the ve CLI without requiring `pip install -e .`.
# Installed users get the `ve` entry point declared in pyproject.toml.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m vllm_evolve.cli.main "$@"
