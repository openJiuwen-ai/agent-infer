# Runtime output (generated by `ar`/`ve` rounds / benchmarks; per-machine, not committed)
logs/
# run-centric working area: runs/<target>/<ts>-<mode>-<run_id>/ (artifacts/layout.py).
# Working bundles, not the curated winner store (archive_policies/) — never committed.
runs/
# DESIGN.md §6 archive: per-run eval_result.json written by `ar keep` / `ar discard`
archive_policies/
# .ve/ is runtime state (phase machine, design scratch; renamed from .ar/). Curated review
# reports now live in docs/reviews/ (tracked); nothing under .ve/ is committed.
.ve/
.ar/

# Claude Code assets are NOT committed. The single authored source of truth is
# src/vllm_evolve/assets/claude/; `ar init` materializes them into a project's
# .claude/ (generated, machine-specific, never hand-edited). See README.
.claude/

# macOS
.DS_Store

# vLLM upstream (reference only, not part of this repo)
vllm/

# Python
__pycache__/
*.pyc
*.pyo
*.pkl
*.egg-info/
.pytest_cache/
dist/
build/
*.egg

# Binaries / presentations
*.pptx
*.ppt
*.zip
.~*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Coverage
.coverage
htmlcov/
