# Env
.env
.env.local
.venv/
.venv*/

# Database (generated)
*.db
*.db-shm
*.db-wal

# Editor backups
*.bkp
.$*
.humanize*

# Codex review scratch: `codex review` writes temp PowerShell git-diff helpers
# (e.g. .tmp_git_tree_diff.ps1) when its sandbox can't spawn git — transient tool
# artifacts, never committed.
.tmp_*
