        <!-- Step 4: Evaluator -->
        <mxCell id="evaluator" value="&lt;b&gt;Evaluator&lt;/b&gt;&lt;br&gt;Simulator / Live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="200" height="60" as="geometry"/>
