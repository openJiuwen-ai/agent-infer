# Example only: replace the SSH alias and workspace for your own GPU host.
# The SSH alias is defined in ~/.ssh/config so both ssh and scp honor the port/key.
VE_REMOTE=gpu-host
VE_REMOTE_WORKSPACE=/workspace/vllm-evolve
VE_REMOTE_REPO=/workspace/vllm-evolve/repo/current
VE_MINIFORGE_PREFIX=/workspace/vllm-evolve/miniforge3
VE_CONDA_ENV=/workspace/vllm-evolve/envs/vllm-evolve
VE_CONDA_SH=/workspace/vllm-evolve/miniforge3/etc/profile.d/conda.sh
VE_LOCAL_ARTIFACT_ROOT=runs/real_vllm
VE_GPUS=0
VE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VE_HF_ENDPOINT=https://huggingface.co
