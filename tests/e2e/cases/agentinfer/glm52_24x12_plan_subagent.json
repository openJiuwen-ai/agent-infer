{
  "test_name": "glm52_24x12_plan_subagent",
  "scenario": "agentinfer",
  "mark": [
    {
      "hardware_marks": {
        "res": {
          "npu": "Ascend"
        },
        "num_cards": 16
      }
    }
  ],
  "description": "GLM-5.2 AgentInfer scheduler bridge, SWE-bench 24 tasks x 12 concurrency",
  "serve_env": {
    "HCCL_OP_EXPANSION_MODE": "AIV",
    "OMP_PROC_BIND": "false",
    "OMP_NUM_THREADS": "1",
    "HCCL_BUFFSIZE": "200",
    "PYTORCH_NPU_ALLOC_CONF": "expandable_segments:True",
    "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1",
    "VLLM_ASCEND_ENABLE_FUSED_MC2": "0",
    "VLLM_ASCEND_MODEL_EXECUTE_TIME_OBSERVE": "1"
  },
  "server_params": {
    "model": "Eco-Tech/GLM-5.2-w4a8c8",
    "middleware": [
      "agentinfer.agentcache.core.api_adapter.AgentCacheIdentityMiddleware",
      "agentinfer.agentcache.core.api_adapter.AgentCacheLifecycleMiddleware"
    ],
    "serve_args": {
      "served-model-name": "glm-5",
      "enable-prefix-caching": true,
      "api-server-count": 1,
      "data-parallel-size": 1,
      "enable-expert-parallel": true,
      "tensor-parallel-size": 16,
      "seed": 1024,
      "tool-call-parser": "glm47",
      "reasoning-parser": "glm45",
      "enable-auto-tool-choice": true,
      "max-num-seqs": 12,
      "max-model-len": 180000,
      "max-num-batched-tokens": 8192,
      "trust-remote-code": true,
      "gpu-memory-utilization": 0.92,
      "quantization": "ascend",
      "compilation-config": {
        "cudagraph_mode": "FULL_DECODE_ONLY"
      },
      "speculative-config": {
        "num_speculative_tokens": 3,
        "method": "deepseek_mtp",
        "enforce_eager": true
      },
      "enable-prompt-tokens-details": true,
      "async-scheduling": true,
      "scheduler-cls": "agentinfer.agentcache.core.scheduler.AgentCacheAsyncSchedulerBridge",
      "additional-config": {
        "enable_dsa_cp": true,
        "enable_sparse_sfa_c8": false,
        "enable_sparse_li_c8": true,
        "enable_balance_scheduling": true,
        "multistream_overlap_shared_expert": true,
        "agentcache": {
          "observability": {
            "enabled": true,
            "log_interval_seconds": 5
          },
          "backend_id": "replay-local-auto-prefix",
          "controller_factory": "agentinfer.agentcache.core.factory.build_progress_ttl_controller",
          "schedule_interval_seconds": 3,
          "progress_ttl": {
            "mode": "auto",
            "ttl_min_seconds": 0.05,
            "ttl_max_seconds": 32,
            "ttl_max_cache_miss_impact_ratio": 1.0,
            "shared_prefix_freshness_warmup_seconds": 100.0,
            "auto_enable_utility_seconds": 20.0,
            "auto_disable_utility_seconds": 5.0,
            "target_max_segment_rounds": 9,
            "resume_capacity_ratio": 1.0,
            "pause_capacity_ratio": 1.0,
            "privileged_max_context_tokens": 85000,
            "privileged_ttl_seconds": 5,
            "paused_program_ttl_seconds": 1800,
            "ttl_prefill_model_intercept_seconds": 0.0,
            "ttl_prefill_model_linear_seconds_per_1k_tokens": 0.0,
            "ttl_prefill_model_quadratic_seconds_per_1k_tokens_squared": 0.001,
            "ttl_decode_throughput_alpha": 1.0,
            "decode_step_fixed_seconds": 0.03,
            "decode_step_seconds_per_request": 0.0,
            "decode_step_seconds_per_context_token": 5.2631579e-8
          }
        }
      }
    }
  },
  "result_root": "test-results/agentinfer",
  "benchmark_params": {
    "config": "agentinfer/agentbench/configs/swebench_vllm.yaml",
    "prepare_dataset": "swebench",
    "prepare_output_dir": "agentinfer/agentbench/data/swebench",
    "host": "127.0.0.1",
    "port": 8000,
    "model": "glm-5",
    "agent-executable": "/path/to/claude",
    "agent-profile": "plan-subagent",
    "benchmark-run-as-user": "test-user",
    "task-num": 24,
    "max-concurrency": 12,
    "timeout": 3600
  }
}
