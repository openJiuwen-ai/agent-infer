{
  "test_name": "glm52_16x8_plan_subagent",
  "scenario": "baseline",
  "mark": [
    {
      "hardware_marks": {
        "res": {
          "npu": "Ascend"
        },
        "num_cards": 16
      }
    }
  ],
  "description": "GLM-5.2 Ascend baseline AsyncScheduler serve profile (16 TP), 16 tasks x 8 concurrency",
  "serve_env": {
    "HCCL_OP_EXPANSION_MODE": "AIV",
    "OMP_PROC_BIND": "false",
    "OMP_NUM_THREADS": "1",
    "HCCL_BUFFSIZE": "200",
    "PYTORCH_NPU_ALLOC_CONF": "expandable_segments:True",
    "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1",
    "VLLM_ASCEND_ENABLE_FUSED_MC2": "0"
  },
  "server_params": {
    "model": "Eco-Tech/GLM-5.2-w4a8c8",
    "serve_args": {
      "served-model-name": "glm-5",
      "enable-prefix-caching": true,
      "api-server-count": 1,
      "data-parallel-size": 1,
      "enable-expert-parallel": true,
      "tensor-parallel-size": 16,
      "seed": 1024,
      "tool-call-parser": "glm47",
      "reasoning-parser": "glm45",
      "enable-auto-tool-choice": true,
      "max-num-seqs": 12,
      "max-model-len": 180000,
      "max-num-batched-tokens": 8192,
      "trust-remote-code": true,
      "gpu-memory-utilization": 0.92,
      "quantization": "ascend",
      "compilation-config": {
        "cudagraph_mode": "FULL_DECODE_ONLY"
      },
      "speculative-config": {
        "num_speculative_tokens": 3,
        "method": "deepseek_mtp",
        "enforce_eager": true
      },
      "enable-prompt-tokens-details": true,
      "async-scheduling": true,
      "scheduler-cls": "vllm.v1.core.sched.async_scheduler.AsyncScheduler",
      "additional-config": {
        "enable_dsa_cp": true,
        "enable_sparse_sfa_c8": false,
        "enable_sparse_li_c8": true,
        "enable_balance_scheduling": true,
        "multistream_overlap_shared_expert": true
      }
    }
  },
  "result_root": "test-results/vllm",
  "benchmark_params": {
    "config": "agentinfer/agentbench/configs/swebench_vllm.yaml",
    "prepare_dataset": "swebench",
    "prepare_output_dir": "agentinfer/agentbench/data/swebench",
    "host": "127.0.0.1",
    "port": 8000,
    "model": "glm-5",
    "agent-executable": "/path/to/claude",
    "agent-profile": "plan-subagent",
    "benchmark-run-as-user": "test-user",
    "task-num": 16,
    "max-concurrency": 8,
    "timeout": 3600
  }
}
